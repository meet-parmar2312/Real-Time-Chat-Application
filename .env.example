# ==========================================
# Real-Time Chat Application Configuration
# ==========================================

# Application
PROJECT_NAME="Real-Time Chat Application"
ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1

# Security & JWT
SECRET_KEY=c8e9b4d3f2a10786e5d4c3b2a19087e6d5c4b3a21908e7d6c5b4a3928170f6e5
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=chat_user
POSTGRES_PASSWORD=chat_password
POSTGRES_DB=chat_db

# Asynchronous SQLAlchemy connection string (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://chat_user:chat_password@localhost:5432/chat_db

# CORS Configuration (JSON array of allowed origins)
BACKEND_CORS_ORIGINS=["http://localhost", "http://localhost:3000", "http://localhost:8000"]
